{
  "name": "dsh-trajectory-graph",
  "version": "0.1.0",
  "description": "Architecture-graph conversation view for DeepSeek Harness: a fixed-topology diagram of the agent loop with scope-driven card readings, animated edge traffic, a Trajectory-style timeline, and a per-node details drawer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "graph",
    "trajectory",
    "visualization",
    "web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moi-ginger/dsh-trajectory-graph.git"
  },
  "homepage": "https://github.com/Moi-ginger/dsh-trajectory-graph#readme",
  "bugs": {
    "url": "https://github.com/Moi-ginger/dsh-trajectory-graph/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lightningcss": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "~18.3.1"
  }
}
